<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Selenium.Support" Version="4.34.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.34.0" />
    <!--
      ChromeDriver'ı bilerek paket olarak sabitlemiyoruz. Sabit sürüm, Chrome her
      güncellendiğinde uyuşmazlık hatası veriyordu. Selenium.WebDriver ile gelen
      Selenium Manager, kurulu Chrome sürümüne uyan sürücüyü kendisi indirip önbelleğe alıyor.
    -->
  </ItemGroup>

</Project>
